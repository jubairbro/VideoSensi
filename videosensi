# Output directory chooser
choose_output_dir() {
    show_logo
    draw_box "Output Directory Chooser"
    echo -e "${YELLOW}Current output directory: ${CYAN}$OUTPUT_DIR${NC}"
    echo -e "${YELLOW}Enter new directory path (or ENTER to keep):${NC}"
    read -p $'\033[1;36mPath: \033[0m' new_dir
    if [ -n "$new_dir" ]; then
        new_dir=$(echo "$new_dir" | tr -d "'")
        if mkdir -p "$new_dir" 2>/dev/null && [ -w "$new_dir" ]; then
            OUTPUT_DIR="$new_dir"
            echo -e "${GREEN}Output directory changed to: ${CYAN}$OUTPUT_DIR${NC}"
            log_operation "Change Output Dir" "Success" "Set to $OUTPUT_DIR"
        else
            echo -e "${RED}Invalid or unwritable directory! Try /sdcard or $HOME/output${NC}"
            log_operation "Change Output Dir" "Failed" "Invalid path: $new_dir"
        fi
    fi
    read -p $'\033[1;36mPress ENTER to continue...\033[0m' dummy
}

# Generate unique output filename
generate_output_name() {
    local input="$1"
    local prefix="$2"
    local extension="${input##*.}"
    local base="$(basename "$input" ".$extension")"
    local output="$OUTPUT_DIR/${base}_${prefix}_Jubairbro.${extension}"
    local counter=1
    while [ -f "$output" ]; do
        output="$OUTPUT_DIR/${base}_${prefix}_Jubairbro($counter).${extension}"
        ((counter++))
    done
    echo "$output"
}

# Compression function
compress_video() {
    local input="$1"
    local quality="$2"
    if ! validate_file "$input"; then
        log_operation "Compression" "Failed" "Invalid input: $input"
        return 1
    fi
    local output=$(generate_output_name "$input" "compressed")
    local crf preset
    case $quality in
        1)
            crf=32
            preset="ultrafast"
            ;;
        2)
            crf=28
            preset="superfast"
            ;;
        3)
            crf=24
            preset="medium"
            ;;
        4)
            crf=20
            preset="slow"
            ;;
        5)
            crf=16
            preset="veryslow"
            ;;
    esac
    echo -e "${YELLOW}Compressing video (Quality Level $quality)...${NC}"
    if ffmpeg -i "$input" -c:v libx264 -crf "$crf" -preset "$preset" -pix_fmt yuv420p "$output" 2> /tmp/ffmpeg_error.log; then
        echo -e "${GREEN}Success! Output saved to: ${CYAN}$output${NC}"
        log_operation "Compression" "Success" "Quality:$quality Output:$output"
        return 0
    else
        echo -e "${RED}Compression failed!${NC}"
        echo -e "${YELLOW}Error details:${NC}"
        cat /tmp/ffmpeg_error.log
        log_operation "Compression" "Failed" "Quality:$quality Input:$input Error:$(cat /tmp/ffmpeg_error.log)"
        return 1
    fi
}

# Watermark function
add_watermark() {
    local input="$1"
    local watermark_text="$2"
    if ! validate_file "$input"; then
        log_operation "Watermark" "Failed" "Invalid input: $input"
        return 1
    fi
    if [ -z "$watermark_text" ]; then
        echo -e "${RED}Watermark text cannot be empty!${NC}"
        log_operation "Watermark" "Failed" "Empty watermark text"
        return 1
    fi
    local output=$(generate_output_name "$input" "watermarked")
    echo -e "${YELLOW}Adding watermark to video...${NC}"
    if ffmpeg -i "$input" -vf "drawtext=text='$watermark_text':x=10:y=H-th-10:fontsize=24:fontcolor=white@0.7:box=1:boxcolor=black@0.5" -codec:a copy "$output" 2> /tmp/ffmpeg_error.log; then
        echo -e "${GREEN}Success! Output saved to: ${CYAN}$output${NC}"
        log_operation "Watermark" "Success" "Text:'$watermark_text' Output:$output"
        return 0
    else
        echo -e "${RED}Watermarking failed!${NC}"
        echo -e "${YELLOW}Error details:${NC}"
        cat /tmp/ffmpeg_error.log
        log_operation "Watermark" "Failed" "Text:'$watermark_text' Input:$input Error:$(cat /tmp/ffmpeg_error.log)"
        return 1
    fi
}

# Conversion function
convert_video() {
    local input="$1"
    local format="$2"
    if ! validate_file "$input"; then
        log_operation "Conversion" "Failed" "Invalid input: $input"
        return 1
    fi
    local output=$(generate_output_name "$input" "converted")
    local codec ext
    case $format in
        1)
            codec="libx264"
            ext="mp4"
            ;;
        2)
            codec="libx265"
            ext="mkv"
            ;;
        3)
            codec="libx264"
            ext="mov"
            ;;
        4)
            codec="libvpx-vp9"
            ext="webm"
            ;;
        5)
            codec="mpeg4"
            ext="avi"
            ;;
    esac
    echo -e "${YELLOW}Converting to $ext format...${NC}"
    if ffmpeg -i "$input" -c:v "$codec" -pix_fmt yuv420p "$output" 2> /tmp/ffmpeg_error.log; then
        echo -e "${GREEN}Success! Output saved to: ${CYAN}$output${NC}"
        log_operation "Conversion" "Success" "Format:$ext Output:$output"
        return 0
    else
        echo -e "${RED}Conversion failed!${NC}"
        echo -e "${YELLOW}Error details:${NC}"
        cat /tmp/ffmpeg_error.log
        log_operation "Conversion" "Failed" "Format:$ext Input:$input Error:$(cat /tmp/ffmpeg_error.log)"
        return 1
    fi
}

