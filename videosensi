# Configuration
VERSION="3.5"
CONFIG_DIR="$HOME/.videosensi"
LOG_DIR="$CONFIG_DIR/logs"
OUTPUT_DIR="/sdcard/VideoSensi"
BACKUP_DIR="$CONFIG_DIR/backups"
WATERMARK_IMAGE="$CONFIG_DIR/watermark.png"
UPDATE_FILE="$CONFIG_DIR/update.txt"
TELEGRAM_CHANNEL="https://t.me/JubairFF"
GITHUB_REPO="https://github.com/jubairbro/VideoSensi"

# Initialize directories
mkdir -p "$CONFIG_DIR" "$LOG_DIR" "$OUTPUT_DIR" "$BACKUP_DIR"

# Colors
RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
PURPLE='\033[1;35m'
CYAN='\033[1;36m'
WHITE='\033[1;37m'
NC='\033[0m'

# Random Color Function
random_color() {
    colors=($RED $GREEN $YELLOW $BLUE $PURPLE $CYAN $WHITE)
    echo "${colors[$RANDOM % 7]}"
}

# Clean Terminal with Random Color
clean_terminal() {
    clear
    color=$(random_color)
    echo -e "${color}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "oooooo     oooo  o8o        .o8                      "
    echo " \`888.     .8'   \`\"'       \"888                      "
    echo "  \`888.   .8'   oooo   .oooo888   .ooooo.   .ooooo.  "
    echo "   \`888. .8'    \`888  d88' \`888  d88' \`88b d88' \`88b "
    echo "    \`888.8'      888  888   888  888ooo888 888   888 "
    echo "     \`888'       888  888   888  888    .o 888   888 "
    echo "      \`8'       o888o \`Y8bod88P\" \`Y8bod8P' \`Y8bod8P'"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo -e "${NC}"
}

# Draw Box with Random Color
draw_box() {
    local text="$1"
    color=$(random_color)
    local width=60
    local padding=4
    
    local text_length=${#text}
    local box_width=$(( text_length + padding * 2 ))
    [ $box_width -lt $width ] && box_width=$width
    
    # Top Border
    echo -ne "${color}┌"
    for ((i=0; i<box_width; i++)); do echo -ne "─"; done
    echo -ne "┐\n"
    
    # Text Line
    echo -ne "│"
    for ((i=0; i<(box_width-text_length)/2; i++)); do echo -ne " "; done
    echo -ne "$text"
    for ((i=0; i<(box_width-text_length+1)/2; i++)); do echo -ne " "; done
    echo -ne "│\n"
    
    # Bottom Border
    echo -ne "└"
    for ((i=0; i<box_width; i++)); do echo -ne "─"; done
    echo -ne "┘${NC}\n"
}

# Animated Progress Bar
progress_bar() {
    local duration=${1:-3}
    local bar_length=30
    local sleep_interval=$(echo "scale=5; $duration/$bar_length" | bc)
    color=$(random_color)
    
    echo -ne "${color}["
    for ((i=0; i<bar_length; i++)); do
        echo -ne "="
        sleep $sleep_interval
    done
    echo -ne "]${NC}\r"
    echo -ne "\n"
}

# Check FFmpeg
check_ffmpeg() {
    if ! command -v ffmpeg &> /dev/null; then
        draw_box "FFmpeg not found! Installing..."
        pkg install -y ffmpeg &> /dev/null
        if ! command -v ffmpeg &> /dev/null; then
            draw_box "Failed to install FFmpeg!" "red"
            exit 1
        fi
    fi
}

# Backup System
backup_file() {
    local file="$1"
    local timestamp=$(date +%Y%m%d_%H%M%S)
    local backup="$BACKUP_DIR/$(basename "$file")_$timestamp.bak"
    
    if cp "$file" "$backup"; then
        echo -e "${YELLOW}Backup saved: $backup${NC}"
        return 0
    else
        echo -e "${RED}Backup failed!${NC}"
        return 1
    fi
}

# Text Watermark
add_text_watermark() {
    local input="$1"
    local output="$2"
    local text="${3:-JubairFF}"
    
    ffmpeg -i "$input" -vf "drawtext=text='$text':x=10:y=H-th-10:fontsize=24:fontcolor=white@0.7:box=1:boxcolor=black@0.5" -codec:a copy "$output" &> /dev/null
}

# Image Watermark
add_image_watermark() {
    local input="$1"
    local output="$2"
    
    if [ ! -f "$WATERMARK_IMAGE" ]; then
        echo -e "${RED}Watermark image not found!${NC}"
        return 1
    fi
    
    ffmpeg -i "$input" -i "$WATERMARK_IMAGE" -filter_complex "overlay=10:10" -codec:a copy "$output" &> /dev/null
}

# Compress Video
compress_video() {
    clean_terminal
    draw_box "VIDEO COMPRESSION"
    
    read -p $'\033[1;36mEnter video path (or drag & drop): \033[0m' input_file
    input_file=$(echo "$input_file" | tr -d "'")
    
    if [ ! -f "$input_file" ]; then
        echo -e "${RED}Error: File not found!${NC}"
        sleep 2
        return
    fi
    
    # Create backup
    backup_file "$input_file"
    
    filename=$(basename -- "$input_file")
    output_file="$OUTPUT_DIR/${filename%.*}_compressed.mp4"
    
    # Quality selection
    echo -e "\n${YELLOW}Select Quality Level:${NC}"
    echo "  [1] Ultra Low (Smallest size)"
    echo "  [2] Low (Small size)"
    echo "  [3] Medium (Balanced)"
    echo "  [4] High (Better quality)"
    echo "  [5] Ultra High (Best quality)"
    
    read -p $'\033[1;36mSELECT QUALITY [1-5]: \033[0m' quality
    
    case $quality in
        1) crf=32; preset="ultrafast" ;;
        2) crf=28; preset="superfast" ;;
        3) crf=24; preset="medium" ;;
        4) crf=20; preset="slow" ;;
        5) crf=16; preset="veryslow" ;;
        *) crf=24; preset="medium" ;;
    esac
    
    # Compression
    draw_box "COMPRESSING VIDEO..."
    echo -e "${YELLOW}Please wait...${NC}"
    
    if ffmpeg -i "$input_file" -c:v libx264 -crf $crf -preset $preset -pix_fmt yuv420p "$output_file" &> /dev/null; then
        original_size=$(du -h "$input_file" | cut -f1)
        new_size=$(du -h "$output_file" | cut -f1)
        
        draw_box "COMPRESSION COMPLETE!"
        echo -e "${GREEN}Original: $original_size → Compressed: $new_size${NC}"
        echo -e "${GREEN}Output saved to: $output_file${NC}"
    else
        draw_box "COMPRESSION FAILED!" "red"
        echo -e "${RED}Error occurred during compression!${NC}"
    fi
    
    read -p $'\033[1;36mPress ENTER to continue...\033[0m' dummy
}

# Convert Format
convert_format() {
    clean_terminal
    draw_box "CONVERT VIDEO FORMAT"
    
    read -p $'\033[1;36mEnter video path (or drag & drop): \033[0m' input_file
    input_file=$(echo "$input_file" | tr -d "'")
    
    if [ ! -f "$input_file" ]; then
        echo -e "${RED}Error: File not found!${NC}"
        sleep 2
        return
    fi
    
    # Format selection
    echo -e "\n${YELLOW}Select Output Format:${NC}"
    echo "  [1] MP4 (H.264)"
    echo "  [2] MKV (H.265)"
    echo "  [3] MOV (Apple)"
    echo "  [4] WEBM (VP9)"
    echo "  [5] AVI (Legacy)"
    
    read -p $'\033[1;36mSELECT FORMAT [1-5]: \033[0m' format
    
    filename=$(basename -- "$input_file")
    
    case $format in
        1) output="$OUTPUT_DIR/${filename%.*}.mp4"; codec="libx264" ;;
        2) output="$OUTPUT_DIR/${filename%.*}.mkv"; codec="libx265" ;;
        3) output="$OUTPUT_DIR/${filename%.*}.mov"; codec="libx264" ;;
        4) output="$OUTPUT_DIR/${filename%.*}.webm"; codec="libvpx-vp9" ;;
        5) output="$OUTPUT_DIR/${filename%.*}.avi"; codec="mpeg4" ;;
        *) output="$OUTPUT_DIR/${filename%.*}.mp4"; codec="libx264" ;;
    esac
    
    # Conversion
    draw_box "CONVERTING VIDEO..."
    echo -e "${YELLOW}Please wait...${NC}"
    
    if ffmpeg -i "$input_file" -c:v $codec -pix_fmt yuv420p "$output" &> /dev/null; then
        draw_box "CONVERSION COMPLETE!"
        echo -e "${GREEN}Output saved to: $output${NC}"
    else
        draw_box "CONVERSION FAILED!" "red"
        echo -e "${RED}Error occurred during conversion!${NC}"
    fi
    
    read -p $'\033[1;36mPress ENTER to continue...\033[0m' dummy
}

# Watermark Menu
watermark_menu() {
    while true; do
        clean_terminal
        draw_box "ADD WATERMARK"
        
        read -p $'\033[1;36mEnter video path (or drag & drop): \033[0m' input_file
        input_file=$(echo "$input_file" | tr -d "'")
        
        if [ ! -f "$input_file" ]; then
            echo -e "${RED}Error: File not found!${NC}"
            sleep 2
            continue
        fi
        
        filename=$(basename -- "$input_file")
        output="$OUTPUT_DIR/${filename%.*}_watermarked.mp4"
        
        echo -e "\n${YELLOW}Select Watermark Type:${NC}"
        echo "  [1] Image Watermark"
        echo "  [2] Text Watermark"
        echo "  [0] Back to Main Menu"
        
        read -p $'\033[1;36mSELECT OPTION [0-2]: \033[0m' choice
        
        case $choice in
            1)
                if add_image_watermark "$input_file" "$output"; then
                    draw_box "WATERMARK ADDED!"
                    echo -e "${GREEN}Output saved to: $output${NC}"
                else
                    draw_box "FAILED TO ADD WATERMARK!" "red"
                fi
                ;;
            2)
                read -p $'\033[1;36mEnter watermark text: \033[0m' text
                if add_text_watermark "$input_file" "$output" "$text"; then
                    draw_box "WATERMARK ADDED!"
                    echo -e "${GREEN}Output saved to: $output${NC}"
                else
                    draw_box "FAILED TO ADD WATERMARK!" "red"
                fi
                ;;
            0)
                return
                ;;
            *)
                echo -e "${RED}Invalid option!${NC}"
                ;;
        esac
        
        read -p $'\033[1;36mPress ENTER to continue...\033[0m' dummy
    done
}

# View Logs
view_logs() {
    clean_terminal
    draw_box "SYSTEM LOGS"
    
    echo -e "${YELLOW}Backups Directory:${NC}"
    ls -lh "$BACKUP_DIR"
    
    echo -e "\n${YELLOW}Compression Logs:${NC}"
    if [ -f "$LOG_DIR/compression.log" ]; then
        cat "$LOG_DIR/compression.log"
    else
        echo "No logs found"
    fi
    
    read -p $'\033[1;36mPress ENTER to continue...\033[0m' dummy
}

# System Cleanup
system_cleanup() {
    clean_terminal
    draw_box "SYSTEM CLEANUP"
    
    echo -e "${YELLOW}Cleaning temporary files...${NC}"
    rm -f /tmp/videosensi*
    
    echo -e "${YELLOW}Cleaning old backups...${NC}"
    find "$BACKUP_DIR" -type f -mtime +7 -delete
    
    draw_box "CLEANUP COMPLETE!"
    read -p $'\033[1;36mPress ENTER to continue...\033[0m' dummy
}

# Check Updates
check_updates() {
    clean_terminal
    draw_box "CHECK FOR UPDATES"
    
    echo -e "${YELLOW}Checking GitHub for updates...${NC}"
    
    if remote_version=$(curl -s "$GITHUB_REPO/raw/main/update.txt"); then
        if [ "$remote_version" != "$VERSION" ]; then
            draw_box "UPDATE AVAILABLE: v$remote_version"
            echo -e "${GREEN}Current version: v$VERSION${NC}"
            echo -e "${GREEN}New version: v$remote_version${NC}"
            
            read -p $'\033[1;36mUpdate now? [Y/n]: \033[0m' choice
            if [[ "$choice" =~ ^[Yy]?$ ]]; then
                echo -e "${YELLOW}Downloading update...${NC}"
                if bash <(curl -s "$GITHUB_REPO/raw/main/setup.sh"); then
                    exit 0
                else
                    echo -e "${RED}Update failed!${NC}"
                fi
            fi
        else
            draw_box "YOU HAVE THE LATEST VERSION"
            echo -e "${GREEN}No updates available${NC}"
        fi
    else
        draw_box "UPDATE CHECK FAILED" "red"
        echo -e "${RED}Could not connect to GitHub${NC}"
    fi
    
    read -p $'\033[1;36mPress ENTER to continue...\033[0m' dummy
}

# Exit Script
exit_script() {
    clean_terminal
    draw_box "THANK YOU FOR USING VIDEO SENSI"
    echo -e "${YELLOW}Telegram: @JubairFF${NC}"
    echo -e "${YELLOW}GitHub: github.com/jubairbro/VideoSensi${NC}"
    exit 0
}

# Main Menu
main_menu() {
    check_ffmpeg
    
    while true; do
        clean_terminal
        draw_box "VIDEO SENSI v$VERSION"
        
        echo -e "${YELLOW}"
        echo "  [1] Compress Video"
        echo "  [2] Convert Format"
        echo "  [3] Add Watermark"
        echo "  [4] View Logs"
        echo "  [5] Check Updates"
        echo "  [6] System Cleanup"
        echo "  [0] Exit"
        echo -e "${NC}"
        
        read -p $'\033[1;36mSELECT OPTION [0-6]: \033[0m' choice
        
        case $choice in
            1) compress_video ;;
            2) convert_format ;;
            3) watermark_menu ;;
            4) view_logs ;;
            5) check_updates ;;
            6) system_cleanup ;;
            0) exit_script ;;
            *) echo -e "${RED}Invalid option!${NC}"; sleep 1 ;;
        esac
    done
}

# Start the application
main_menu
