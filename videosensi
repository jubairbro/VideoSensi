# Function to create backup
create_backup() {
    local input_file="$1"
    local backup_file="$BACKUP_DIR/$(date +%Y%m%d_%H%M%S)_$(basename "$input_file")"
    
    if cp "$input_file" "$backup_file"; then
        echo -e "${GREEN}Backup created: ${CYAN}$backup_file${NC}"
        return 0
    else
        echo -e "${RED}Failed to create backup!${NC}"
        return 1
    fi
}

# Generate unique output filename
generate_output_name() {
    local input="$1"
    local prefix="$2"
    local extension="${input##*.}"
    local base="$(basename "$input" ".$extension")"
    local output="$OUTPUT_DIR/${base}_${prefix}_Jubairbro.${extension}"
    local counter=1

    while [ -f "$output" ]; do
        output="$OUTPUT_DIR/${base}_${prefix}_Jubairbro($counter).${extension}"
        ((counter++))
    done

    echo "$output"
}

# Compression function with backup
compress_video() {
    local input="$1"
    local quality="$2"
    
    # Create backup first
    if ! create_backup "$input"; then
        return 1
    fi

    local output=$(generate_output_name "$input" "compressed")
    local crf
    local preset

    case $quality in
        1) crf=32; preset="ultrafast";;
        2) crf=28; preset="superfast";;
        3) crf=24; preset="medium";;
        4) crf=20; preset="slow";;
        5) crf=16; preset="veryslow";;
    esac

    echo -e "${YELLOW}Compressing video (Quality Level $quality)...${NC}"
    if ffmpeg -i "$input" -c:v libx264 -crf $crf -preset $preset -pix_fmt yuv420p "$output" &> /dev/null; then
        echo -e "${GREEN}Success! Output saved to:${NC}"
        echo -e "${CYAN}$output${NC}"
        return 0
    else
        echo -e "${RED}Compression failed!${NC}"
        return 1
    fi
}

# Watermark function
add_watermark() {
    local input="$1"
    local watermark_text="$2"
    local output=$(generate_output_name "$input" "watermarked")

    echo -e "${YELLOW}Adding watermark to video...${NC}"
    if ffmpeg -i "$input" -vf "drawtext=text='$watermark_text':x=10:y=H-th-10:fontsize=24:fontcolor=white@0.7:box=1:boxcolor=black@0.5" -codec:a copy "$output" &> /dev/null; then
        echo -e "${GREEN}Success! Watermarked video saved to:${NC}"
        echo -e "${CYAN}$output${NC}"
        return 0
    else
        echo -e "${RED}Watermarking failed!${NC}"
        return 1
    fi
}

# Conversion function
convert_video() {
    local input="$1"
    local format="$2"
    local output=$(generate_output_name "$input" "converted")

    case $format in
        1) codec="libx264"; ext="mp4";;
        2) codec="libx265"; ext="mkv";;
        3) codec="libx264"; ext="mov";;
        4) codec="libvpx-vp9"; ext="webm";;
        5) codec="mpeg4"; ext="avi";;
    esac

    echo -e "${YELLOW}Converting to $ext format...${NC}"
    if ffmpeg -i "$input" -c:v $codec -pix_fmt yuv420p "$output" &> /dev/null; then
        echo -e "${GREEN}Success! Converted video saved to:${NC}"
        echo -e "${CYAN}$output${NC}"
        return 0
    else
        echo -e "${RED}Conversion failed!${NC}"
        return 1
    fi
}

