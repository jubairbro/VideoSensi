# Setup script for global access
setup_global_access() {
    # Check if already installed
    if [ -f "$PREFIX/bin/videosensi" ]; then
        echo -e "\033[1;33mUpdating existing installation...\033[0m"
        rm -f "$PREFIX/bin/videosensi"
    fi
    
    # Copy script to bin directory
    cp "$0" "$PREFIX/bin/videosensi"
    chmod +x "$PREFIX/bin/videosensi"
    
    # Create README.md
    echo -e "# VideoSensi - Ultimate Video Processing Tool for Termux\n\nVersion: $VERSION\n\n## Features\n- Video compression with 5 quality levels\n- Format conversion between popular formats\n- Watermark addition\n- Detailed logs\n- Regular updates\n\n## Installation\nJust run \`videosensi\` from anywhere in Termux after setup.\n\n## Author\nJubair (@JubairFF)" > "$CONFIG_DIR/README.md"
    
    # Create update.txt
    echo "$VERSION" > "$CONFIG_DIR/update.txt"
    
    echo -e "\033[1;32mSetup complete! You can now run 'videosensi' from anywhere.\033[0m"
    exit 0
}

