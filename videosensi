# Animated progress bar
progress_bar() {
    local duration=${1}
    local bar_length=50
    local sleep_interval=$(echo "scale=5; $duration/$bar_length" | bc)
    local progress=0
    
    echo -ne "\033[1;34m["
    for ((i=0; i<bar_length; i++)); do
        echo -ne "="
        sleep $sleep_interval
    done
    echo -ne "]\033[0m\r"
    echo -ne "\n"
}

# Colorful box-style UI
draw_box() {
    local text="$1"
    local color="$2"
    local width=60
    local padding=4
    local border_char="═"
    local side_char="║"
    local corner_char="╔╗╝╚"
    
    # Set color
    case $color in
        red)    color_code="\033[1;31m" ;;
        green)  color_code="\033[1;32m" ;;
        yellow) color_code="\033[1;33m" ;;
        blue)   color_code="\033[1;34m" ;;
        purple) color_code="\033[1;35m" ;;
        cyan)   color_code="\033[1;36m" ;;
        *)      color_code="\033[1;37m" ;;
    esac
    
    # Calculate box dimensions
    local text_length=${#text}
    local box_width=$(( text_length + padding * 2 ))
    [ $box_width -lt $width ] && box_width=$width
    
    # Draw top border
    echo -ne "${color_code}${corner_char:0:1}"
    for ((i=0; i<box_width; i++)); do echo -ne "$border_char"; done
    echo -ne "${corner_char:1:1}\n"
    
    # Draw text line
    echo -ne "$side_char"
    for ((i=0; i<(box_width-text_length)/2; i++)); do echo -ne " "; done
    echo -ne "$text"
    for ((i=0; i<(box_width-text_length+1)/2; i++)); do echo -ne " "; done
    echo -ne "$side_char\n"
    
    # Draw bottom border
    echo -ne "${corner_char:3:1}"
    for ((i=0; i<box_width; i++)); do echo -ne "$border_char"; done
    echo -ne "${corner_char:2:1}\033[0m\n"
}

