# Compress video function
compress_video() {
    show_logo
    draw_box "VIDEO COMPRESSION" "blue"
    
    # Get input file
    read -p $'\033[1;36mEnter video path (or drag & drop): \033[0m' input_file
    input_file=$(echo "$input_file" | tr -d "'")
    
    # Check if file exists
    if [ ! -f "$input_file" ]; then
        echo -e "\033[1;31mError: File not found!\033[0m"
        sleep 2
        return
    fi
    
    # Show file info
    filename=$(basename -- "$input_file")
    extension="${filename##*.}"
    filename="${filename%.*}"
    
    echo -e "\033[1;32mDetected video: $input_file\033[0m"
    echo -e "\033[1;33mFilename: $filename.$extension\033[0m"
    
    # Quality selection
    echo -e "\033[1;35m"
    echo "  [1] Ultra Low (Smallest size, lowest quality)"
    echo "  [2] Low (Small size, low quality)"
    echo "  [3] Medium (Balanced size and quality)"
    echo "  [4] High (Larger size, better quality)"
    echo "  [5] Ultra High (Largest size, best quality)"
    echo -e "\033[0m"
    
    read -p $'\033[1;36mSELECT QUALITY [1-5]: \033[0m' quality_choice
    
    case $quality_choice in
        1) crf=32; preset="ultrafast"; bitrate="500k" ;;
        2) crf=28; preset="superfast"; bitrate="1000k" ;;
        3) crf=24; preset="medium"; bitrate="2000k" ;;
        4) crf=20; preset="slow"; bitrate="4000k" ;;
        5) crf=16; preset="veryslow"; bitrate="8000k" ;;
        *) crf=24; preset="medium"; bitrate="2000k" ;;
    esac
    
    # Output file
    output_file="$OUTPUT_DIR/${filename}_JubairFF.mp4"
    
    # Compression command
    draw_box "COMPRESSING VIDEO - PLEASE WAIT" "yellow"
    echo -e "\033[1;33mThis may take some time depending on video size...\033[0m"
    
    # Start time for logging
    start_time=$(date +%s)
    
    # First attempt with CRF
    ffmpeg -y -i "$input_file" -c:v libx264 -preset $preset -crf $crf \
           -pix_fmt yuv420p -r 30 -c:a aac -b:a 128k \
           "$output_file" > /dev/null 2>&1 &
    
    pid=$!
    progress_bar 5
    
    wait $pid
    
    # Check if first attempt failed
    if [ ! -f "$output_file" ] || [ $(stat -c%s "$output_file") -eq 0 ]; then
        echo -e "\033[1;31mFirst compression attempt failed. Trying fallback method...\033[0m"
        
        # Fallback to bitrate-based compression
        ffmpeg -y -i "$input_file" -c:v libx264 -preset $preset -b:v $bitrate \
               -pix_fmt yuv420p -r 30 -c:a aac -b:a 128k \
               "$output_file" > /dev/null 2>&1 &
        
        pid=$!
        progress_bar 5
        wait $pid
    fi
    
    # End time for logging
    end_time=$(date +%s)
    duration=$((end_time - start_time))
    
    # Verify output
    if [ -f "$output_file" ]; then
        original_size=$(du -h "$input_file" | cut -f1)
        compressed_size=$(du -h "$output_file" | cut -f1)
        
        # Log the operation
        log_entry="$(date '+%Y-%m-%d %H:%M:%S') | $filename.$extension | $original_size -> $compressed_size | ${duration}s | CRF:$crf"
        echo "$log_entry" >> "$LOG_DIR/compression.log"
        
        draw_box "COMPRESSION COMPLETE!" "green"
        echo -e "\033[1;32mOriginal size: $original_size\033[0m"
        echo -e "\033[1;32mCompressed size: $compressed_size\033[0m"
        echo -e "\033[1;32mTime taken: ${duration} seconds\033[0m"
        echo -e "\033[1;32mOutput saved to: $output_file\033[0m"
    else
        draw_box "COMPRESSION FAILED!" "red"
        echo -e "\033[1;31mFailed to compress the video. Please try again.\033[0m"
    fi
    
    read -p $'\033[1;36mPress ENTER to continue...\033[0m' dummy
}

# Convert video format
convert_format() {
    show_logo
    draw_box "VIDEO FORMAT CONVERSION" "blue"
    
    # Get input file
    read -p $'\033[1;36mEnter video path (or drag & drop): \033[0m' input_file
    input_file=$(echo "$input_file" | tr -d "'")
    
    # Check if file exists
    if [ ! -f "$input_file" ]; then
        echo -e "\033[1;31mError: File not found!\033[0m"
        sleep 2
        return
    fi
    
    # Show file info
    filename=$(basename -- "$input_file")
    extension="${filename##*.}"
    filename="${filename%.*}"
    
    echo -e "\033[1;32mDetected video: $input_file\033[0m"
    echo -e "\033[1;33mCurrent format: $extension\033[0m"
    
    # Format selection
    echo -e "\033[1;35m"
    echo "  [1] MP4 (H.264/AAC)"
    echo "  [2] MKV (H.264/AAC)"
    echo "  [3] MOV (H.264/AAC)"
    echo "  [4] WEBM (VP9/Opus)"
    echo "  [5] AVI (MPEG-4/MP3)"
    echo -e "\033[0m"
    
    read -p $'\033[1;36mSELECT OUTPUT FORMAT [1-5]: \033[0m' format_choice
    
    case $format_choice in
        1) output_ext="mp4"; codec="libx264"; audio="aac" ;;
        2) output_ext="mkv"; codec="libx264"; audio="aac" ;;
        3) output_ext="mov"; codec="libx264"; audio="aac" ;;
        4) output_ext="webm"; codec="libvpx-vp9"; audio="libopus" ;;
        5) output_ext="avi"; codec="mpeg4"; audio="libmp3lame" ;;
        *) output_ext="mp4"; codec="libx264"; audio="aac" ;;
    esac
    
    # Output file
    output_file="$OUTPUT_DIR/${filename}_JubairFF.$output_ext"
    
    # Conversion command
    draw_box "CONVERTING VIDEO - PLEASE WAIT" "yellow"
    echo -e "\033[1;33mThis may take some time depending on video size...\033[0m"
    
    ffmpeg -y -i "$input_file" -c:v $codec -preset medium -pix_fmt yuv420p \
           -r 30 -c:a $audio -b:a 128k "$output_file" > /dev/null 2>&1 &
    
    pid=$!
    progress_bar 5
    wait $pid
    
    # Verify output
    if [ -f "$output_file" ]; then
        draw_box "CONVERSION COMPLETE!" "green"
        echo -e "\033[1;32mOutput saved to: $output_file\033[0m"
        
        # Log the operation
        log_entry="$(date '+%Y-%m-%d %H:%M:%S') | $filename.$extension -> $output_ext | Format conversion"
        echo "$log_entry" >> "$LOG_DIR/conversion.log"
    else
        draw_box "CONVERSION FAILED!" "red"
        echo -e "\033[1;31mFailed to convert the video. Please try again.\033[0m"
    fi
    
    read -p $'\033[1;36mPress ENTER to continue...\033[0m' dummy
}

# Add watermark to video
add_watermark() {
    show_logo
    draw_box "ADD WATERMARK TO VIDEO" "blue"
    
    # Check if watermark image exists
    if [ ! -f "$WATERMARK_IMAGE" ]; then
        echo -e "\033[1;33mWatermark image not found. Creating default watermark...\033[0m"
        
        # Create a simple watermark image using ImageMagick
        if command -v convert &> /dev/null; then
            convert -size 200x50 xc:none -fill '#FFFFFF80' -pointsize 20 \
                    -gravity center -annotate 0 'JubairFF' \
                    "$WATERMARK_IMAGE"
        else
            echo -e "\033[1;31mImageMagick not installed. Cannot create default watermark.\033[0m"
            echo -e "\033[1;33mPlease install ImageMagick or place your own watermark at: $WATERMARK_IMAGE\033[0m"
            sleep 3
            return
        fi
    fi
    
    # Get input file
    read -p $'\033[1;36mEnter video path (or drag & drop): \033[0m' input_file
    input_file=$(echo "$input_file" | tr -d "'")
    
    # Check if file exists
    if [ ! -f "$input_file" ]; then
        echo -e "\033[1;31mError: File not found!\033[0m"
        sleep 2
        return
    fi
    
    # Show file info
    filename=$(basename -- "$input_file")
    extension="${filename##*.}"
    filename="${filename%.*}"
    
    echo -e "\033[1;32mDetected video: $input_file\033[0m"
    
    # Watermark position selection
    echo -e "\033[1;35m"
    echo "  [1] Top Left"
    echo "  [2] Top Right"
    echo "  [3] Bottom Left"
    echo "  [4] Bottom Right"
    echo "  [5] Center"
    echo -e "\033[0m"
    
    read -p $'\033[1;36mSELECT WATERMARK POSITION [1-5]: \033[0m' position_choice
    
    case $position_choice in
        1) position="10:10" ;;
        2) position="main_w-overlay_w-10:10" ;;
        3) position="10:main_h-overlay_h-10" ;;
        4) position="main_w-overlay_w-10:main_h-overlay_h-10" ;;
        5) position="(main_w-overlay_w)/2:(main_h-overlay_h)/2" ;;
        *) position="main_w-overlay_w-10:main_h-overlay_h-10" ;;
    esac
    
    # Output file
    output_file="$OUTPUT_DIR/${filename}_Watermarked_JubairFF.mp4"
    
    # Watermark command
    draw_box "ADDING WATERMARK - PLEASE WAIT" "yellow"
    echo -e "\033[1;33mThis may take some time depending on video size...\033[0m"
    
    ffmpeg -y -i "$input_file" -i "$WATERMARK_IMAGE" \
           -filter_complex "[1]format=rgba,colorchannelmixer=aa=0.5[wm];[0][wm]overlay=$position:format=auto" \
           -c:v libx264 -preset medium -crf 22 -pix_fmt yuv420p \
           -c:a copy "$output_file" > /dev/null 2>&1 &
    
    pid=$!
    progress_bar 5
    wait $pid
    
    # Verify output
    if [ -f "$output_file" ]; then
        draw_box "WATERMARK ADDED SUCCESSFULLY!" "green"
        echo -e "\033[1;32mOutput saved to: $output_file\033[0m"
        
        # Log the operation
        log_entry="$(date '+%Y-%m-%d %H:%M:%S') | $filename.$extension | Watermark added"
        echo "$log_entry" >> "$LOG_DIR/watermark.log"
    else
        draw_box "WATERMARK FAILED!" "red"
        echo -e "\033[1;31mFailed to add watermark. Please try again.\033[0m"
    fi
    
    read -p $'\033[1;36mPress ENTER to continue...\033[0m' dummy
}

