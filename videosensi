# Generate unique output filename
get_output_file() {
    local input="$1"
    local suffix="$2"
    local ext="${input##*.}"
    local base="$(basename "$input" ".$ext")"
    local output="$OUTPUT_DIR/${base}_${suffix}_Jubairbro.${ext}"
    local count=1
    while [ -f "$output" ]; do
        output="$OUTPUT_DIR/${base}_${suffix}_Jubairbro($count).${ext}"
        ((count++))
    done
    echo "$output"
}

# Display processing with fast typing effect
display_processing() {
    local message="$1"
    local dots=""
    for i in {1..10}; do
        echo -en "\r$YELLOW $message$dots$RESET"
        dots="$dots."
        sleep 0.05 # Fast typing effect
    done
    echo -en "\r$YELLOW $message...$RESET\n"
}

# Display spinner animation with custom message
display_spinner() {
    local pid="$1"
    local message="$2"
    local spinner=("⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏")
    while kill -0 "$pid" 2>/dev/null; do
        for i in "${spinner[@]}"; do
            echo -en "\r$YELLOW $message $i$RESET"
            sleep 0.1
            kill -0 "$pid" 2>/dev/null || break 2
        done
    done
    echo -en "\r$GREEN Completed!               $RESET\n"
}

# Compress video with spinner animation and fallback system
compress_video() {
    local input="$1"
    local quality="$2"
    if ! validate_file "$input"; then
        log_operation "compress" "failed" "input:$input"
        return 1
    fi
    if ! check_output_dir; then
        return 1
    fi
    local output=$(get_output_file "$input" "compressed")
    local crf preset
    case $quality in
        1) crf=32; preset="ultrafast" ;;
        2) crf=28; preset="superfast" ;;
        3) crf=24; preset="medium" ;;
        4) crf=20; preset="slow" ;;
        5) crf=16; preset="veryslow" ;;
    esac
    echo -e "$YELLOW Compressing video (Level $quality)...$RESET"
    display_processing "Starting compression"

    # First attempt: Default H.264 with AAC
    (ffmpeg -i "$input" -c:v libx264 -crf "$crf" -preset "$preset" -pix_fmt yuv420p -c:a aac "$output" 2>>"$ERROR_LOG") &
    local pid=$!
    display_spinner "$pid" "Compressing (Attempt 1: H.264)"
    wait "$pid"
    if [ $? -eq 0 ]; then
        echo -e "$GREEN Completed! Saved: $CYAN$output$RESET"
        log_operation "compress" "success" "level:$quality method:1 output:$output"
        return 0
    else
        echo -e "$YELLOW First attempt failed, trying fallback method...$RESET"
        log_operation "compress" "failed" "level:$quality method:1 input:$input"

        # Fallback attempt: H.265 with MP3 (alternative codec)
        output=$(get_output_file "$input" "compressed_fallback")
        (ffmpeg -i "$input" -c:v libx265 -crf "$crf" -preset "$preset" -pix_fmt yuv420p -c:a mp3 "$output" 2>>"$ERROR_LOG") &
        pid=$!
        display_spinner "$pid" "Compressing (Attempt 2: H.265)"
        wait "$pid"
        if [ $? -eq 0 ]; then
            echo -e "$GREEN Fallback succeeded! Saved: $CYAN$output$RESET"
            log_operation "compress" "success" "level:$quality method:2 output:$output"
            return 0
        else
            echo -e "$RED Compression failed! Details in log: $CYAN$ERROR_LOG$RESET"
            echo -e "$YELLOW Last error: $RESET"
            tail -n 5 "$ERROR_LOG" | while read -r line; do
                echo -e "$YELLOW $line$RESET"
            done
            log_operation "compress" "failed" "level:$quality method:2 input:$input"
            return 1
        fi
    fi
}

# Add watermark with spinner animation, customization, and fallback system
add_watermark() {
    local input="$1"
    local text="$2"
    if ! validate_file "$input"; then
        log_operation "watermark" "failed" "input:$input"
        return 1
    fi
    if ! check_output_dir; then
        return 1
    fi
    if [ -z "$text" ]; then
        echo -e "$RED Error: Watermark text required!$RESET"
        log_operation "watermark" "failed" "no_text"
        return 1
    fi

    # Select watermark size
    echo -e "$CYAN Select watermark size:$RESET"
    echo -e "  [1] Normal (24px)"
    echo -e "  [2] Small (28px)"
    echo -e "  [3] Medium (32px)"
    echo -e "  [4] Big (36px)"
    echo -ne "$CYAN Select [1-4]: $RESET"
    read size_choice
    case $size_choice in
        1) fontsize=24 ;;
        2) fontsize=28 ;;
        3) fontsize=32 ;;
        4) fontsize=36 ;;
        *) echo -e "$RED Invalid choice! Using Normal (24px).$RESET"; fontsize=24 ;;
    esac

    # Select watermark color
    echo -e "$CYAN Select watermark color:$RESET"
    echo -e "  [1] White"
    echo -e "  [2] Yellow"
    echo -e "  [3] Cyan"
    echo -e "  [4] Green"
    echo -e "  [5] Magenta"
    echo -ne "$CYAN Select [1-5]: $RESET"
    read color_choice
    case $color_choice in
        1) fontcolor="white@0.7" ;;
        2) fontcolor="yellow@0.7" ;;
        3) fontcolor="cyan@0.7" ;;
        4) fontcolor="green@0.7" ;;
        5) fontcolor="magenta@0.7" ;;
        *) echo -e "$RED Invalid choice! Using White.$RESET"; fontcolor="white@0.7" ;;
    esac

    # Select watermark position
    echo -e "$CYAN Select watermark position:$RESET"
    echo -e "  [1] Left-Down"
    echo -e "  [2] Right-Down"
    echo -e "  [3] Left-Up"
    echo -e "  [4] Right-Up"
    echo -ne "$CYAN Select [1-4]: $RESET"
    read position_choice
    case $position_choice in
        1) position="x=10:y=H-th-10" ;;
        2) position="x=W-tw-10:y=H-th-10" ;;
        3) position="x=10:y=10" ;;
        4) position="x=W-tw-10:y=10" ;;
        *) echo -e "$RED Invalid choice! Using Left-Down.$RESET"; position="x=10:y=H-th-10" ;;
    esac

    local output=$(get_output_file "$input" "watermarked")
    echo -e "$YELLOW Adding watermark...$RESET"
    display_processing "Starting watermark"

    # First attempt: Default drawtext with box
    (ffmpeg -i "$input" -vf "drawtext=text='$text':$position:fontsize=$fontsize:fontcolor=$fontcolor:box=1:boxcolor=black@0.5" -codec:a copy "$output" 2>>"$ERROR_LOG") &
    local pid=$!
    display_spinner "$pid" "Watermarking (Attempt 1: Drawtext)"
    wait "$pid"
    if [ $? -eq 0 ]; then
        echo -e "$GREEN Completed! Saved: $CYAN$output$RESET"
        log_operation "watermark" "success" "text:'$text' size:$fontsize color:$fontcolor position:$position method:1 output:$output"
        return 0
    else
        echo -e "$YELLOW First attempt failed, trying fallback method...$RESET"
        log_operation "watermark" "failed" "text:'$text' size:$fontsize color:$fontcolor position:$position method:1 input:$input"

        # Fallback attempt: Overlay with static image (simplified watermark)
        local temp_img="/tmp/watermark.png"
        convert -size 100x50 xc:none -fill "$fontcolor" -draw "text 10,40 '$text'" "$temp_img" 2>/dev/null
        output=$(get_output_file "$input" "watermarked_fallback")
        (ffmpeg -i "$input" -i "$temp_img" -filter_complex "overlay=$position" -codec:a copy "$output" 2>>"$ERROR_LOG") &
        pid=$!
        display_spinner "$pid" "Watermarking (Attempt 2: Overlay)"
        wait "$pid"
        rm -f "$temp_img" 2>/dev/null
        if [ $? -eq 0 ]; then
            echo -e "$GREEN Fallback succeeded! Saved: $CYAN$output$RESET"
            log_operation "watermark" "success" "text:'$text' size:$fontsize color:$fontcolor position:$position method:2 output:$output"
            return 0
        else
            echo -e "$RED Watermark failed! Details in log: $CYAN$ERROR_LOG$RESET"
            echo -e "$YELLOW Last error: $RESET"
            tail -n 5 "$ERROR_LOG" | while read -r line; do
                echo -e "$YELLOW $line$RESET"
            done
            log_operation "watermark" "failed" "text:'$text' size:$fontsize color:$fontcolor position:$position method:2 input:$input"
            return 1
        fi
    fi
}

# Convert video with spinner animation and fallback system
convert_video() {
    local input="$1"
    local format="$2"
    if ! validate_file "$input"; then
        log_operation "convert" "failed" "input:$input"
        return 1
    fi
    if ! check_output_dir; then
        return 1
    fi
    local output=$(get_output_file "$input" "converted")
    local codec ext
    case $format in
        1) codec="libx264"; ext="mp4" ;;
        2) codec="libx265"; ext="mkv" ;;
        3) codec="libx264"; ext="mov" ;;
        4) codec="libvpx-vp9"; ext="webm" ;;
        5) codec="mpeg4"; ext="avi" ;;
    esac
    output="${output%.*}.$ext"  # Ensure correct extension for output
    echo -e "$YELLOW Converting to $ext...$RESET"
    display_processing "Starting conversion"

    # First attempt: Default conversion with AAC audio
    (ffmpeg -i "$input" -c:v "$codec" -pix_fmt yuv420p -c:a aac "$output" 2>>"$ERROR_LOG") &
    local pid=$!
    display_spinner "$pid" "Converting (Attempt 1: $ext with AAC)"
    wait "$pid"
    if [ $? -eq 0 ]; then
        echo -e "$GREEN Completed! Saved: $CYAN$output$RESET"
        log_operation "convert" "success" "format:$ext method:1 output:$output"
        return 0
    else
        echo -e "$YELLOW First attempt failed, trying fallback method...$RESET"
        log_operation "convert" "failed" "format:$ext method:1 input:$input"

        # Fallback attempt: Alternative audio codec (MP3) with same video codec
        output=$(get_output_file "$input" "converted_fallback")
        output="${output%.*}.$ext"  # Ensure correct extension
        (ffmpeg -i "$input" -c:v "$codec" -pix_fmt yuv420p -c:a mp3 "$output" 2>>"$ERROR_LOG") &
        pid=$!
        display_spinner "$pid" "Converting (Attempt 2: $ext with MP3)"
        wait "$pid"
        if [ $? -eq 0 ]; then
            echo -e "$GREEN Fallback succeeded! Saved: $CYAN$output$RESET"
            log_operation "convert" "success" "format:$ext method:2 output:$output"
            return 0
        else
            echo -e "$RED Conversion failed! Details in log: $CYAN$ERROR_LOG$RESET"
            echo -e "$YELLOW Last error: $RESET"
            tail -n 5 "$ERROR_LOG" | while read -r line; do
                echo -e "$YELLOW $line$RESET"
            done
            log_operation "convert" "failed" "format:$ext method:2 input:$input"
            return 1
        fi
    fi
}

