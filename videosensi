# Backup menu
backup_menu() {
    while true; do
        show_logo
        echo -e "${PURPLE}"
        echo "┌──────────────────────────────────────┐"
        echo "│          BACKUP MENU                 │"
        echo "└──────────────────────────────────────┘"
        echo -e "${NC}"
        echo -e "${YELLOW}Available Backups:${NC}"
        ls -lh "$BACKUP_DIR" | awk '{print $9, $5}'
        echo -e "\n${YELLOW}Options:${NC}"
        echo "  [1] Restore Backup"
        echo "  [2] Clean Old Backups"
        echo "  [0] Back to Main Menu"
        echo -e "${NC}"

        read -p $'\033[1;36mSELECT OPTION [0-2]: \033[0m' choice

        case $choice in
            1)
                read -p $'\033[1;36mEnter backup filename: \033[0m' backup_file
                if [ -f "$BACKUP_DIR/$backup_file" ]; then
                    cp "$BACKUP_DIR/$backup_file" "$OUTPUT_DIR/restored_$backup_file"
                    echo -e "${GREEN}Backup restored to:${NC}"
                    echo -e "${CYAN}$OUTPUT_DIR/restored_$backup_file${NC}"
                else
                    echo -e "${RED}Backup file not found!${NC}"
                fi
                read -p $'\033[1;36mPress ENTER to continue...\033[0m' dummy
                ;;
            2)
                echo -e "${YELLOW}Cleaning backups older than 7 days...${NC}"
                find "$BACKUP_DIR" -type f -mtime +7 -delete
                echo -e "${GREEN}Cleanup complete!${NC}"
                read -p $'\033[1;36mPress ENTER to continue...\033[0m' dummy
                ;;
            0) break ;;
            *) echo -e "${RED}Invalid option!${NC}"; sleep 1 ;;
        esac
    done
}

