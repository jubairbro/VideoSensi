    echo "│ ${title^} │"
    echo "└──────────────────────────────────────┘"
    echo -e "${NC}"
}

# Log operations
log_operation() {
    local operation="$1"
    local status="$2"
    local details="$3"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $operation | Status: $status | Details: $details" >> "$LOG_FILE"
}

# Check dependencies
check_dependencies() {
    local deps=("ffmpeg" "curl" "git")
    for dep in "${deps[@]}"; do
        if ! command -v "$dep" > /dev/null 2>&1; then
            echo -e "${RED}$dep not found! Installing...${NC}"
            if ! pkg install -y "$dep"; then
                echo -e "${RED}Failed to install $dep! Please run 'pkg install $dep' manually.${NC}"
                exit 1
            fi
            if ! command -v "$dep" > /dev/null 2>&1; then
                echo -e "${RED}$dep installation failed!${NC}"
                exit 1
            fi
        fi
    done
    echo -e "${GREEN}All dependencies installed!${NC}"
}

# Validate file path
validate_file() {
    local file="$1"
    if [ -z "$file" ]; then
        echo -e "${RED}No file path provided!${NC}"
        return 1
    elif [ ! -f "$file" ]; then
        echo -e "${RED}File not found: $file${NC}"
        return 1
    elif [ ! -r "$file" ]; then
        echo -e "${RED}File not readable: $file${NC}"
        return 1
    fi
    return 0
}

# Script updater
check_update() {
    show_logo
    draw_box "Script Updater"
    echo -e "${YELLOW}Checking for updates...${NC}"
    local temp_file="/tmp/videosensi_temp.sh"
    if curl -s -o "$temp_file" "$GITHUB_REPO"; then
        local latest_version=$(grep -m1 "VERSION=" "$temp_file" | cut -d'"' -f2)
        if [ "$latest_version" != "$VERSION" ]; then
            echo -e "${GREEN}New version $latest_version available! Current: $VERSION${NC}"
            read -p $'\033[1;36mUpdate now? [y/N]: \033[0m' choice
            if [ "$choice" = "y" ] || [ "$choice" = "Y" ]; then
                if cp "$temp_file" "$0"; then
                    chmod +x "$0"
                    echo -e "${GREEN}Updated to version $latest_version!${NC}"
                    log_operation "Update" "Success" "Updated to v$latest_version"
                    sleep 2
                    exec "$0"
                else
                    echo -e "${RED}Failed to update script! Check permissions.${NC}"
                    log_operation "Update" "Failed" "Could not copy new script"
                fi
            fi
        else
            echo -e "${GREEN}You have the latest version ($VERSION)!${NC}"
        fi
        rm -f "$temp_file"
    else
        echo -e "${RED}Failed to check for updates! Check network.${NC}"
        log_operation "Update" "Failed" "Network error"
    fi
    read -p $'\033[1;36mPress ENTER to continue...\033[0m' dummy
}

# Log viewer
view_logs() {
    show_logo
    draw_box "Log Viewer"
    if [ -f "$LOG_FILE" ]; then
        echo -e "${YELLOW}Recent Operations:${NC}"
        tail -n 20 "$LOG_FILE" | while read -r line; do
            echo -e "${CYAN}$line${NC}"
        done
    else
        echo -e "${RED}No logs found!${NC}"
    fi
    read -p $'\033[1;36mPress ENTER to continue...\033[0m' dummy
}

# System cleaner
clean_system() {
    show_logo
    draw_box "System Cleaner"
    echo -e "${YELLOW}Cleaning Options:${NC}"
    echo "  [1] Clean Old Logs (>7 days)"
    echo "  [2] Clean Output Directory"
    echo "  [0] Back to Main Menu"
    read -p $'\033[1;36mSELECT OPTION [0-2]: \033[0m' choice
    case $choice in
        1)
            if find "$LOG_DIR" -type f -mtime +7 -delete; then
                echo -e "${GREEN}Old logs cleaned!${NC}"
                log_operation "Clean Logs" "Success" "Removed logs older than 7 days"
            else
                echo -e "${RED}Failed to clean logs!${NC}"
                log_operation "Clean Logs" "Failed" "Error cleaning logs"
            fi
            ;;
        2)
            read -p $'\033[1;36mConfirm output directory cleanup? [y/N]: \033[0m' confirm
            if [ "$confirm" = "y" ] || [ "$confirm" = "Y" ]; then
                if find "$OUTPUT_DIR" -type f -delete; then
                    echo -e "${GREEN}Output directory cleaned!${NC}"
                    log_operation "Clean Output" "Success" "Cleared output directory"
                else
                    echo -e "${RED}Failed to clean output directory!${NC}"
                    log_operation "Clean Output" "Failed" "Error cleaning output directory"
                fi
            fi
            ;;
        0)
            return
            ;;
        *)
            echo -e "${RED}Invalid option!${NC}"
            ;;
    esac
    read -p $'\033[1;36mPress ENTER to continue...\033[0m' dummy
}

