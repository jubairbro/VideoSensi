# Clean system
clean_system() {
    clear  # Clear the screen
    display_logo  # Show the logo
    display_menu "System Cleaner"
    echo -e "$MAGENTA Choose cleaning option:$RESET"
    echo -e "  [1] Remove logs older than 7 days"
    echo -e "  [2] Clear output directory ($OUTPUT_DIR)"
    echo -e "  [0] Return to main menu"
    echo -ne "$CYAN Select [0-2]: $RESET"
    read choice
    case $choice in
        1)
            if find "$LOG_DIR" -type f -mtime +7 -exec rm -f {} + 2>/dev/null; then
                echo -e "$GREEN Old logs removed successfully!$RESET"
                log_operation "clean_logs" "success" "older_than_7d"
            else
                echo -e "$RED Failed to remove old logs. Check permissions.$RESET"
                log_operation "clean_logs" "failed" "permission_error"
            fi
            ;;
        2)
            echo -ne "$CYAN Confirm clear output? [y/N]: $RESET"
            read confirm
            if [ "$confirm" = "y" ] || [ "$confirm" = "Y" ]; then
                if find "$OUTPUT_DIR" -type f -exec rm -f {} + 2>/dev/null; then
                    echo -e "$GREEN Output directory cleared!$RESET"
                    log_operation "clean_output" "success" "dir:$OUTPUT_DIR"
                else
                    echo -e "$RED Failed to clear output. Check storage.$RESET"
                    log_operation "clean_output" "failed" "storage_error"
                fi
            fi
            ;;
        0) return ;;
        *) echo -e "$RED Invalid choice!$RESET" ;;
    esac
    echo -ne "$CYAN Press ENTER to return...$RESET"
    read
}

