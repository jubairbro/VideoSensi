# Check update (optional) with internet check
check_update() {
    clear  # Clear the screen
    display_logo  # Show the logo
    display_menu "Check for Updates"
    if ! check_internet; then
        echo -e "$RED Update check skipped: No internet.$RESET"
        echo -ne "$CYAN Press ENTER to return...$RESET"
        read
        return
    fi
    echo -e "$YELLOW Check for new version? (Optional)$RESET"
    echo -ne "$CYAN Proceed? [y/N]: $RESET"
    read choice
    if [ "$choice" = "y" ] || [ "$choice" = "Y" ]; then
        echo -e "$YELLOW Checking for updates...$RESET"
        local temp_file="/tmp/vs_temp"
        if curl -s -o "$temp_file" "$UPDATE_URL"; then
            local new_version=$(grep -m1 "VERSION=" "$temp_file" | cut -d'"' -f2)
            if [ "$new_version" != "$VERSION" ]; then
                echo -e "$GREEN New version $new_version available! Current: $VERSION$RESET"
                echo -ne "$CYAN Update now? [y/N]: $RESET"
                read confirm
                if [ "$confirm" = "y" ] || [ "$confirm" = "Y" ]; then
                    if cp "$temp_file" "$0" 2>/dev/null; then
                        chmod +x "$0"
                        echo -e "$GREEN Updated to v$new_version!$RESET"
                        log_operation "update" "success" "version:$new_version"
                        sleep 2
                        exec "$0"
                    else
                        echo -e "$RED Update failed! Check permissions.$RESET"
                        log_operation "update" "failed" "copy_error"
                    fi
                fi
            else
                echo -e "$GREEN You're on the latest version: $VERSION$RESET"
            fi
            rm -f "$temp_file"
        else
            echo -e "$RED Network error or update unavailable.$RESET"
            log_operation "update" "failed" "network"
        fi
    else
        echo -e "$YELLOW Update check skipped.$RESET"
    fi
    echo -ne "$CYAN Press ENTER to return...$RESET"
    read
}

