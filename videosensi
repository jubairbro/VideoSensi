# Check dependencies
check_dependencies() {
    if ! command -v ffmpeg &> /dev/null; then
        echo -e "${RED}FFmpeg not found! Installing...${NC}"
        pkg install -y ffmpeg
        if ! command -v ffmpeg &> /dev/null; then
            echo -e "${RED}Failed to install FFmpeg!${NC}"
            exit 1
        fi
    fi
}

