# Configuration
VERSION="2.2"
CONFIG_DIR="$HOME/.videosensi"
LOG_DIR="$CONFIG_DIR/logs"
OUTPUT_DIR="/sdcard/VideoSensi"
WATERMARK_IMAGE="$CONFIG_DIR/watermark.png"
UPDATE_FILE="$CONFIG_DIR/update.txt"
TELEGRAM_CHANNEL="https://t.me/JubairFF"
GITHUB_REPO="https://github.com/jubairbro/VideoSensi"

# Initialize
mkdir -p "$CONFIG_DIR" "$LOG_DIR" "$OUTPUT_DIR"

# Colors
RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
PURPLE='\033[1;35m'
CYAN='\033[1;36m'
NC='\033[0m'

# ASCII Logo
show_logo() {
    clear
    echo -e "${PURPLE}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "oooooo     oooo  o8o        .o8                      "
    echo " \`888.     .8'   \`\"'       \"888                      "
    echo "  \`888.   .8'   oooo   .oooo888   .ooooo.   .ooooo.  "
    echo "   \`888. .8'    \`888  d88' \`888  d88' \`88b d88' \`88b "
    echo "    \`888.8'      888  888   888  888ooo888 888   888 "
    echo "     \`888'       888  888   888  888    .o 888   888 "
    echo "      \`8'       o888o \`Y8bod88P\" \`Y8bod8P' \`Y8bod8P'"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo -e "${NC}"
}

# Draw Box
draw_box() {
    local text="$1"
    local color="$2"
    local width=60
    local padding=4
    
    case $color in
        red)    color_code="${RED}" ;;
        green)  color_code="${GREEN}" ;;
        yellow) color_code="${YELLOW}" ;;
        blue)   color_code="${BLUE}" ;;
        purple) color_code="${PURPLE}" ;;
        cyan)   color_code="${CYAN}" ;;
        *)      color_code="${NC}" ;;
    esac
    
    local text_length=${#text}
    local box_width=$(( text_length + padding * 2 ))
    [ $box_width -lt $width ] && box_width=$width
    
    # Top Border
    echo -ne "${color_code}┌"
    for ((i=0; i<box_width; i++)); do echo -ne "─"; done
    echo -ne "┐\n"
    
    # Text Line
    echo -ne "│"
    for ((i=0; i<(box_width-text_length)/2; i++)); do echo -ne " "; done
    echo -ne "$text"
    for ((i=0; i<(box_width-text_length+1)/2; i++)); do echo -ne " "; done
    echo -ne "│\n"
    
    # Bottom Border
    echo -ne "└"
    for ((i=0; i<box_width; i++)); do echo -ne "─"; done
    echo -ne "┘\033[0m\n"
}

# Progress Bar
progress_bar() {
    local duration=${1:-5}
    local bar_length=50
    local sleep_interval=$(echo "scale=5; $duration/$bar_length" | bc)
    local progress=0
    
    echo -ne "\033[1;34m["
    for ((i=0; i<bar_length; i++)); do
        echo -ne "="
        sleep $sleep_interval
    done
    echo -ne "]\033[0m\r"
    echo -ne "\n"
}

# Check FFmpeg
check_ffmpeg() {
    if ! command -v ffmpeg &> /dev/null; then
        echo -e "${RED}FFmpeg not found! Installing...${NC}"
        pkg install -y ffmpeg
        if ! command -v ffmpeg &> /dev/null; then
            echo -e "${RED}Failed to install FFmpeg. Please install it manually.${NC}"
            exit 1
        fi
    fi
}

# Compress Video
compress_video() {
    show_logo
    draw_box "VIDEO COMPRESSION" "blue"
    
    read -p $'\033[1;36mEnter video path (or drag & drop): \033[0m' input_file
    input_file=$(echo "$input_file" | tr -d "'")
    
    if [ ! -f "$input_file" ]; then
        echo -e "${RED}Error: File not found!${NC}"
        sleep 2
        return
    fi
    
    filename=$(basename -- "$input_file")
    extension="${filename##*.}"
    filename="${filename%.*}"
    
    echo -e "${GREEN}Detected video: $input_file${NC}"
    echo -e "${YELLOW}Filename: $filename.$extension${NC}"
    
    echo -e "\033[1;35m"
    echo "  [1] Ultra Low (Smallest size, lowest quality)"
    echo "  [2] Low (Small size, low quality)"
    echo "  [3] Medium (Balanced size and quality)"
    echo "  [4] High (Larger size, better quality)"
    echo "  [5] Ultra High (Largest size, best quality)"
    echo -e "\033[0m"
    
    read -p $'\033[1;36mSELECT QUALITY [1-5]: \033[0m' quality_choice
    
    case $quality_choice in
        1) crf=32; preset="ultrafast"; bitrate="500k" ;;
        2) crf=28; preset="superfast"; bitrate="1000k" ;;
        3) crf=24; preset="medium"; bitrate="2000k" ;;
        4) crf=20; preset="slow"; bitrate="4000k" ;;
        5) crf=16; preset="veryslow"; bitrate="8000k" ;;
        *) crf=24; preset="medium"; bitrate="2000k" ;;
    esac
    
    output_file="$OUTPUT_DIR/${filename}_JubairFF.mp4"
    
    draw_box "COMPRESSING VIDEO - PLEASE WAIT" "yellow"
    echo -e "${YELLOW}This may take some time depending on video size...${NC}"
    
    start_time=$(date +%s)
    
    ffmpeg -y -i "$input_file" -c:v libx264 -preset $preset -crf $crf \
           -pix_fmt yuv420p -r 30 -c:a aac -b:a 128k \
           "$output_file" > /dev/null 2>&1 &
    
    pid=$!
    progress_bar 5
    wait $pid
    
    if [ ! -f "$output_file" ] || [ $(stat -c%s "$output_file") -eq 0 ]; then
        echo -e "${RED}First compression attempt failed. Trying fallback method...${NC}"
        
        ffmpeg -y -i "$input_file" -c:v libx264 -preset $preset -b:v $bitrate \
               -pix_fmt yuv420p -r 30 -c:a aac -b:a 128k \
               "$output_file" > /dev/null 2>&1 &
        
        pid=$!
        progress_bar 5
        wait $pid
    fi
    
    end_time=$(date +%s)
    duration=$((end_time - start_time))
    
    if [ -f "$output_file" ]; then
        original_size=$(du -h "$input_file" | cut -f1)
        compressed_size=$(du -h "$output_file" | cut -f1)
        
        log_entry="$(date '+%Y-%m-%d %H:%M:%S') | $filename.$extension | $original_size -> $compressed_size | ${duration}s | CRF:$crf"
        echo "$log_entry" >> "$LOG_DIR/compression.log"
        
        draw_box "COMPRESSION COMPLETE!" "green"
        echo -e "${GREEN}Original size: $original_size${NC}"
        echo -e "${GREEN}Compressed size: $compressed_size${NC}"
        echo -e "${GREEN}Time taken: ${duration} seconds${NC}"
        echo -e "${GREEN}Output saved to: $output_file${NC}"
    else
        draw_box "COMPRESSION FAILED!" "red"
        echo -e "${RED}Failed to compress the video. Please try again.${NC}"
    fi
    
    read -p $'\033[1;36mPress ENTER to continue...\033[0m' dummy
}

# Main Menu
main_menu() {
    while true; do
        show_logo
        draw_box "VIDEO SENSI v$VERSION - MAIN MENU" "purple"
        echo -e "${YELLOW}"
        echo "  [1] Compress Video (5 quality levels)"
        echo "  [2] Convert Format (MP4, MKV, MOV etc.)"
        echo "  [3] Add Watermark (corner logo)"
        echo "  [4] View Compression Logs"
        echo "  [5] Check for Updates"
        echo "  [6] Join Telegram Channel"
        echo "  [0] Exit"
        echo -e "${NC}"
        
        read -p $'\033[1;36mSELECT OPTION [0-6]: \033[0m' choice
        
        case $choice in
            1) compress_video ;;
            2) convert_format ;;
            3) add_watermark ;;
            4) view_logs ;;
            5) check_updates ;;
            6) join_telegram ;;
            0) exit_script ;;
            *) echo -e "${RED}Invalid option! Please try again.${NC}"; sleep 1 ;;
        esac
    done
}

