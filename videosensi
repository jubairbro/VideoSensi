# Log operation
log_operation() {
    local action="$1"
    local status="$2"
    local details="$3"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $action | $status | $details" >> "$OP_LOG" 2>/dev/null
}

# Check dependencies with fallback
check_dependencies() {
    local deps=("ffmpeg" "curl" "git" "ffprobe")
    for dep in "${deps[@]}"; do
        if ! command -v "$dep" >/dev/null 2>&1; then
            echo -e "$YELLOW Warning: $dep missing. Attempting install...$RESET"
            if ! pkg install -y "$dep" 2>/dev/null; then
                echo -e "$RED Error: Failed to install $dep. Install manually.$RESET"
                exit 1
            fi
        fi
    done
    echo -e "$GREEN Dependencies ready!$RESET"
}

# Validate file with robust check
validate_file() {
    local file="$1"
    if [ -z "$file" ] || [ ! -e "$file" ] || [ ! -f "$file" ] || [ ! -r "$file" ]; then
        echo -e "$RED Error: Invalid or inaccessible file: $file$RESET"
        log_operation "validate_file" "failed" "file:$file"
        return 1
    fi
    # Check if the file is a valid video using ffprobe
    if ! ffprobe -v error -show_streams "$file" >/dev/null 2>&1; then
        echo -e "$RED Error: File is not a valid video or is corrupted: $file$RESET"
        log_operation "validate_file" "failed" "invalid_video:$file"
        return 1
    fi
    return 0
}

# Check output directory permissions
check_output_dir() {
    if [ ! -d "$OUTPUT_DIR" ] || [ ! -w "$OUTPUT_DIR" ]; then
        echo -e "$RED Error: Output directory $OUTPUT_DIR is not writable. Run 'termux-setup-storage' or check permissions.$RESET"
        log_operation "check_output_dir" "failed" "dir:$OUTPUT_DIR"
        return 1
    fi
    return 0
}

